      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": 0,
          "location": "US",
          "project": "${project}",
          "rawQuery": true,
          "rawSql": "-- Fleet-wide daily cook temperature: the average line, and the spread\n-- between the coolest and hottest robot that day drawn as a band.\nSELECT *\nFROM (\n  SELECT\n    TIMESTAMP(activity_date)  AS time,\n    ROUND(AVG(avg_temp_c), 2) AS `Fleet avg`,\n    ROUND(MIN(avg_temp_c), 2) AS `Fleet min`,\n    ROUND(MAX(avg_temp_c), 2) AS `Fleet max`\n  FROM `${project}.robot_telemetry.int_robot_daily`\n  WHERE avg_temp_c IS NOT NULL\n  GROUP BY activity_date\n)\nWHERE $__timeFilter(time)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Fleet cook temperature — daily average with min/max band",
      "type": "timeseries"
    }
