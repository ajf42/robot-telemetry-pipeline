          "format": 1,
          "location": "US",
          "project": "${project}",
          "rawQuery": true,
          "rawSql": "-- The problem-robots view: one row per robot, worst error rate first.\nSELECT\n  fleet_rank     AS `Rank`,\n  robot_id       AS `Robot`,\n  site_id        AS `Site`,\n  days_observed  AS `Days`,\n  total_cycles   AS `Cycles`,\n  total_errors   AS `Errors`,\n  error_rate     AS `Error rate`,\n  avg_uptime_pct AS `Uptime`\nFROM `${project}.robot_telemetry.fct_fleet_health`\nORDER BY fleet_rank",
          "refId": "A"
        }
      ],
      "title": "Robot health ranking — worst first",
      "type": "table"
