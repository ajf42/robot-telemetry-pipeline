          "format": 1,
          "location": "US",
          "project": "${project}",
          "rawQuery": true,
          "rawSql": "-- Fleet-wide errors per 100 completed cycles, 7-day window.\n--\n-- Rebuilt from the summed numerator and denominator rather than averaging the\n-- per-robot error_rate column: a robot that completed two cycles and threw one\n-- error would otherwise drag the fleet number as hard as a robot that ran\n-- eight hundred.\nSELECT ROUND(SAFE_DIVIDE(SUM(total_errors) * 100, SUM(total_cycles)), 2) AS error_rate\nFROM `${project}.robot_telemetry.fct_fleet_health`",
          "refId": "A"
        }
      ],
      "title": "Error rate (7d)",
      "type": "stat"
    },
