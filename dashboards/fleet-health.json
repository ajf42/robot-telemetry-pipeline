      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": 0,
          "location": "US",
          "project": "${project}",
          "rawQuery": true,
          "rawSql": "-- Daily error counts, one series per robot.\n--\n-- Runs as Format=Time series: the driver folds the long result (time,\n-- robot_id, error_count) into one series per distinct robot_id, so the fleet\n-- can grow without this query changing.\nSELECT *\nFROM (\n  SELECT\n    TIMESTAMP(activity_date) AS time,\n    robot_id,\n    error_count\n  FROM `${project}.robot_telemetry.int_robot_daily`\n)\nWHERE $__timeFilter(time)\nORDER BY time, robot_id",
          "refId": "A"
        }
      ],
      "title": "Daily errors by robot",
      "type": "timeseries"
    },
