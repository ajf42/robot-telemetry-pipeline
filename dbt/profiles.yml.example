# Copy alongside this file as dbt/profiles.yml and fill in the two placeholders.
#
#   cp dbt/profiles.yml.example dbt/profiles.yml
#
# The copy lives in the repo, not in ~/.dbt: .gitignore already excludes
# dbt/profiles.yml, so the real credentials stay uncommitted while the profile
# stays next to the project it configures. Run dbt from dbt/ and point it here:
#
#   cd dbt && dbt deps && dbt build --profiles-dir .
#
# Authentication is service-account keyfile only, matching ingest/load_bigquery.py.
# The keyfile is the same JSON that GOOGLE_APPLICATION_CREDENTIALS points at.
# Never commit the real profiles.yml or the keyfile.

robot_telemetry:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: your-gcp-project-id # GCP project holding the robot_telemetry dataset
      keyfile: /path/to/service-account.json # absolute path to the service-account JSON
      dataset: robot_telemetry
      location: US
      threads: 4
      priority: interactive
      job_execution_timeout_seconds: 300
      job_retries: 1
